# YAPI 环境变量配置示例文件
# 复制此文件为 .env 并根据需要修改

# 基础配置
YAPI_PORT=3000
YAPI_ADMIN_ACCOUNT=admin@admin.com
YAPI_TIMEOUT=120000

# 数据库配置
YAPI_DB_SERVERNAME=mongodb
YAPI_DB_NAME=yapi
YAPI_DB_PORT=27017
YAPI_DB_USER=test1
YAPI_DB_PASS=test1
YAPI_DB_AUTH_SOURCE=admin

# 邮件配置 - 默认禁用
YAPI_MAIL_ENABLE=false
YAPI_MAIL_HOST=smtp.163.com
YAPI_MAIL_PORT=465
YAPI_MAIL_FROM=
YAPI_MAIL_USER=
YAPI_MAIL_PASS=

# 其他配置
YAPI_CLOSE_REGISTER=false

# 插件配置 - JSON格式的字符串
YAPI_PLUGINS=[{"name":"import-postman"},{"name":"import-har"},{"name":"advanced-mock"}]
